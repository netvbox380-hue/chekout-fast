.app-card-img { width: 100%; height: 88px; display: flex; align-items: center; justify-content: center; }
.img-fastpro { background: linear-gradient(135deg, #1a9aad 0%, #0d6e80 100%); }
.img-fastwin { background: linear-gradient(135deg, #1a9595 0%, #0d7070 100%); }
.img-lazer { background: linear-gradient(135deg, #7c3aed 0%, #4c1d95 100%); }
.img-funplay { background: linear-gradient(135deg, #f97316 0%, #c2410c 100%); }
.img-blessed { background: linear-gradient(135deg, #4f46e5 0%, #312e81 100%); }
.img-xcloud { background: linear-gradient(135deg, #0e9f8e 0%, #065f52 100%); }

/* Logos SVG inline */
.fastpro-logo { display: flex; align-items: center; gap: 6px; }
.fp-text { display: flex; flex-direction: column; line-height: 1; }
.fp-fast { font-size: 26px; font-weight: 900; color: #fff; }
.fp-player { font-size: 13px; font-weight: 700; color: #fff; }
.fp-arrow { width: 0; height: 0; border-top: 14px solid transparent; border-bottom: 14px solid transparent; border-left: 24px solid #f5a623; }

.lazer-logo { display: flex; flex-direction: column; align-items: center; line-height: 1.1; }
.lz-top { font-size: 20px; font-weight: 900; color: #fff; letter-spacing: 3px; }
.lz-play { display: flex; align-items: center; gap: 5px; }
.lz-tri { width: 0; height: 0; border-top: 10px solid transparent; border-bottom: 10px solid transparent; border-left: 18px solid #00d4aa; }
.lz-word { font-size: 22px; font-weight: 900; color: #fff; }

.fun-logo { font-size: 30px; font-weight: 900; color: #fff; display: flex; align-items: center; gap: 4px; }
.fn-tri { display: inline-block; width: 0; height: 0; border-top: 11px solid transparent; border-bottom: 11px solid transparent; border-left: 20px solid #00d4aa; }

.blessed-logo { display: flex; flex-direction: column; align-items: center; gap: 5px; }
