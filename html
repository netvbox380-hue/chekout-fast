.step-list { display: flex; flex-direction: column; gap: 8px; }
.step-item { display: flex; align-items: center; gap: 12px; background: #f8f8f8; border-radius: 10px; padding: 10px 14px; }
.step-num { width: 30px; height: 30px; border-radius: 50%; background: #f5a623; color: #fff; font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
