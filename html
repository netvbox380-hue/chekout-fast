<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: #0a0a18; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #fff; min-height: 100vh; }

/* HERO */
.page { max-width: 520px; margin: 0 auto; }
.hero { padding: 2.5rem 1.5rem 2rem; text-align: center; }
.badge-top { display: inline-flex; align-items: center; gap: 6px; background: rgba(245,166,35,0.13); border: 1px solid rgba(245,166,35,0.35); color: #f5a623; font-size: 11px; font-weight: 600; padding: 5px 14px; border-radius: 999px; margin-bottom: 1.25rem; text-transform: uppercase; letter-spacing: 0.06em; }
.hero-title { font-size: 28px; font-weight: 800; line-height: 1.2; color: #fff; margin-bottom: 0.6rem; }
.hero-title span { color: #f5a623; }
.hero-sub { font-size: 14px; color: rgba(255,255,255,0.5); max-width: 380px; margin: 0 auto 1.8rem; line-height: 1.6; }

.price-block { display: inline-flex; flex-direction: column; align-items: center; background: rgba(255,255,255,0.04); border: 1px solid rgba(245,166,35,0.3); border-radius: 18px; padding: 1.25rem 2.5rem; margin-bottom: 1.8rem; position: relative; }
.pulse-dot { position: absolute; top: -5px; right: -5px; width: 12px; height: 12px; background: #22c55e; border-radius: 50%; animation: pa 2s infinite; }
@keyframes pa { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.5;transform:scale(1.4)} }
.price-label { font-size: 10px; font-weight: 600; color: rgba(255,255,255,0.35); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 2px; }
.price-row { display: flex; align-items: flex-start; gap: 2px; }
.price-cur { font-size: 20px; font-weight: 700; color: #f5a623; margin-top: 8px; }
.price-val { font-size: 72px; font-weight: 800; color: #fff; line-height: 1; }
.price-per { font-size: 13px; color: rgba(255,255,255,0.35); align-self: flex-end; margin-bottom: 8px; }
.price-note { font-size: 11px; color: rgba(245,166,35,0.7); margin-top: 4px; }

.cta-group { display: flex; flex-direction: column; gap: 10px; align-items: center; }
.btn-primary { display: inline-flex; align-items: center; justify-content: center; gap: 9px; background: #f5a623; color: #0d0d1f; font-size: 17px; font-weight: 800; padding: 18px 44px; border-radius: 13px; text-decoration: none; width: 100%; max-width: 380px; border: none; cursor: pointer; transition: background 0.15s, transform 0.1s; letter-spacing: 0.01em; }
.btn-primary:hover { background: #ffba3a; transform: scale(1.01); }
.btn-primary:active { transform: scale(0.97); }
.btn-secondary { display: inline-flex; align-items: center; justify-content: center; gap: 7px; background: transparent; color: rgba(255,255,255,0.6); font-size: 13px; font-weight: 500; padding: 13px 36px; border-radius: 11px; border: 1px solid rgba(255,255,255,0.13); text-decoration: none; width: 100%; max-width: 380px; transition: border-color 0.15s, color 0.15s; }
.btn-secondary:hover { border-color: rgba(255,255,255,0.4); color: #fff; }

.counter-strip { text-align: center; padding: 0.65rem 1rem; background: rgba(245,166,35,0.06); border-top: 1px solid rgba(245,166,35,0.1); border-bottom: 1px solid rgba(245,166,35,0.1); font-size: 12px; color: rgba(245,166,35,0.8); display: flex; align-items: center; justify-content: center; gap: 7px; }
.live-dot { width: 7px; height: 7px; background: #f5a623; border-radius: 50%; animation: pa 1.5s infinite; }
.trust-strip { display: flex; justify-content: center; gap: 20px; padding: 0.75rem 1rem; background: rgba(255,255,255,0.02); border-bottom: 1px solid rgba(255,255,255,0.05); flex-wrap: wrap; }
.trust-item { display: flex; align-items: center; gap: 5px; font-size: 11px; color: rgba(255,255,255,0.4); }
.trust-item i { color: #22c55e; font-size: 13px; }

/* APPS SECTION */
.apps-section { display: none; padding: 1.5rem; }
.apps-section.visible { display: block; }
