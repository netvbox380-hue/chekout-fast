.downloader-box { background: #1a6fd4; border-radius: 12px; padding: 14px 16px; margin-bottom: 10px; }
.downloader-label { font-size: 10px; font-weight: 600; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 4px; }
.downloader-code { font-size: 34px; font-weight: 800; color: #fff; display: flex; align-items: center; gap: 10px; }
